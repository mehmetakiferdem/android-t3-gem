# The board exposes its sensors as IIO devices with no sensors HAL in front of
# them, so GemSensors reads /sys/bus/iio/devices directly. It runs as a system
# app, so the rules land on system_app, but they are scoped to sysfs_iio rather
# than sysfs as a whole.
allow system_app sysfs_iio:dir r_dir_perms;
allow system_app sysfs_iio:file r_file_perms;
allow system_app sysfs_iio:lnk_file read;
