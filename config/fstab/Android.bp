package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

genrule {
    name: "gen_fstab_am62_mmc",
    srcs: ["fstab.in"],
    out: ["fstab.am62"],
    cmd: "sed -e s/@sdio_node@/fa10000.mmc/ -e s/@id_mmc@/1/ $(in) > $(out)",
}

genrule {
    name: "gen_fstab_am62_sdcard",
    srcs: ["fstab.in"],
    out: ["fstab.am62"],
    cmd: "sed -e s/@sdio_node@/fa00000.mmc/ -e s/@id_mmc@/0/ $(in) > $(out)",
}

genrule {
    name: "gen_fstab_am62_mmc_avb",
    srcs: ["fstab.in.avb"],
    out: ["fstab.am62"],
    cmd: "sed -e s/@sdio_node@/fa10000.mmc/ -e s/@id_mmc@/1/ $(in) > $(out)",
}

genrule {
    name: "gen_fstab_am62_sdcard_avb",
    srcs: ["fstab.in.avb"],
    out: ["fstab.am62"],
    cmd: "sed -e s/@sdio_node@/fa00000.mmc/ -e s/@id_mmc@/0/ $(in) > $(out)",
}


prebuilt_etc {
    name: "fstab.am62.mmc",
    src: ":gen_fstab_am62_mmc",
    vendor: true,
    vendor_ramdisk_available: true,
}

prebuilt_etc {
    name: "fstab.am62.sdcard",
    src: ":gen_fstab_am62_sdcard",
    vendor: true,
    vendor_ramdisk_available: true,
}

prebuilt_etc {
    name: "fstab.am62.mmc.avb",
    src: ":gen_fstab_am62_mmc_avb",
    vendor: true,
    vendor_ramdisk_available: true,
}

prebuilt_etc {
    name: "fstab.am62.sdcard.avb",
    src: ":gen_fstab_am62_sdcard_avb",
    vendor: true,
    vendor_ramdisk_available: true,
}

